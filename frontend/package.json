{
  "name": "sazloop-frontend",
  "private": true,
  "description": "Pruebas del frontend de Sazloop con el ejecutor de pruebas de Node 22 o superior y jsdom (navegador simulado). Instalar una vez con: npm install",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"app/vendor/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/*.test.js\" && node -e \"const f='coverage/lcov.info',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/^SF:(.*)$/gm,(l,p)=>'SF:'+p.replace(/\\\\/g,'/')))\""
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
