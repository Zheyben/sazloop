{
  "name": "sazloop-frontend",
  "private": true,
  "description": "Pruebas unitarias del frontend de Sazloop. No hay que instalar nada: usa el ejecutor de pruebas de Node 22 o superior.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/*.test.js\" && node -e \"const f='coverage/lcov.info',fs=require('fs');fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace(/^SF:(.*)$/gm,(l,p)=>'SF:'+p.replace(/\\\\/g,'/')))\""
  }
}
